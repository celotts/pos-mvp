# ============================================================
# POS MVP - Variables de entorno (ejemplo)
# Copia este archivo a .env y sustituye los valores reales.
# NUNCA subas .env al repositorio: contiene secretos.
# ============================================================

# 1. Base de Datos (PostgreSQL / pgvector)
POSTGRES_DB=pos_db
POSTGRES_USER=product
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=pos-db
POSTGRES_PORT=5432

# Credenciales del primer superusuario (se crean al iniciar la BD)
FIRST_SUPERUSER_EMAIL=admin@posAdmin.com
FIRST_SUPERUSER_PASSWORD=change-me
FIRST_SUPERUSER_FULL_NAME=Admin

# 2. Seguridad y Tokens JWT
# OBLIGATORIO: genera uno con `openssl rand -hex 32`
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_SECONDS=90000

# 3. Aplicación
# development | production
ENVIRONMENT=development
# Origenes CORS permitidos (JSON) p.ej. ["https://app.ejemplo.com"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 4. Login
# Intentos fallidos antes de bloquear la cuenta y duración del bloqueo (s)
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_SECONDS=3600
# Máximo de intentos de login por IP y ventana (s)
LOGIN_RATE_LIMIT_PER_MINUTE=100

# 5. IA (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.containers.internal:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=768